
import asyncio
from playwright.async_api import async_playwright

async def test_site_liveness(name, url, selector):
    print(f"Testing {name}...")
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True)
        context = await browser.new_context(
            user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        )
        page = await context.new_page()
        try:
            await page.goto(url, wait_until="networkidle", timeout=30000)
            # For BBC and Flashscore, we look for elements that indicate a match is active
            elements = await page.locator(selector).all()
            if elements:
                print(f"✅ {name}: Found {len(elements)} live markers.")
                sample = await elements[0].inner_text()
                print(f"   Sample Data: {sample}")
                return True
            else:
                # Fallback: check for the word "LIVE" generally
                live_text = await page.locator("text=LIVE").all()
                if live_text:
                    print(f"✅ {name}: Found 'LIVE' text indicators.")
                    return True
                print(f"❌ {name}: No live data found.")
                return False
        except Exception as e:
            print(f"⚠️ {name}: Error - {e}")
            return False
        finally:
            await browser.close()

async def main():
    targets = [
        {"name": "BBC Sport", "url": "https://www.bbc.com/sport/football/scores-fixtures", "selector": ".sc-dfkFvV"},
        {"name": "Flashscore", "url": "https://www.flashscore.com/", "selector": ".event__time"}
    ]

    results = {}
    for target in targets:
        results[target["name"]] = await test_site_liveness(target["name"], target["url"], target["selector"])

    print("\n--- Final Report ---")
    for site, success in results.items():
        print(f"{site}: {'WORKING' if success else 'FAILED'}")

if __name__ == "__main__":
    asyncio.run(main())
